# ---------------------------------------------------------------------------
# KING 253 — environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/king253

# Separate database used by `npm test` — it is wiped between test runs.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/king253_test

# Public URL of the site (used for canonical URLs, sitemap, Open Graph, emails)
NEXT_PUBLIC_SITE_URL=https://example.com

# Stable key for Server Action encryption when running more than one instance.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# SMTP for order emails. Leave SMTP_HOST empty and emails are recorded in the
# admin as "skipped" instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KING 253 <orders@example.com>"

# Where uploaded product images are stored (defaults to ./storage/uploads)
UPLOAD_DIR=
