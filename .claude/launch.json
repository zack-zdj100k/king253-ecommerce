{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "king253-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "king253-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "king253-bundle",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.local",
        "dist/king253/server.js"
      ],
      "port": 3010,
      "env": {
        "PORT": "3010",
        "HOSTNAME": "127.0.0.1",
        "NODE_ENV": "production"
      }
    }
  ]
}
